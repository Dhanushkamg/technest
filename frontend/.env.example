# =============================================================================
# TechNest Frontend Environment Configuration Example
# Copy this file to .env or set these environment variables during Vite build.
# WARNING: All VITE_* variables are exposed to the browser. NEVER store secrets here!
# =============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Canonical Site URL (for SEO OpenGraph and sitemap)
VITE_SITE_URL=http://localhost:5173

# PayHere Gateway Environment
VITE_PAYHERE_SANDBOX=true
