# =============================================================================
# TechNest Backend Environment Configuration Example
# Copy this file to .env or set these environment variables in your deployment.
# NEVER commit real credentials to version control.
# =============================================================================

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_256_bits_long_2026
JWT_EXPIRATION=86400000

# CORS Allowed Origins (comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=https://technest.lk,https://admin.technest.lk

# PayHere Payment Gateway
PAYHERE_MERCHANT_ID=1236634
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_SANDBOX=false
PAYHERE_CURRENCY=LKR
PAYHERE_RETURN_URL=https://technest.lk/order-success
PAYHERE_CANCEL_URL=https://technest.lk/checkout
PAYHERE_NOTIFY_URL=https://api.technest.lk/api/payments/payhere/notify

# Application Profile
SPRING_PROFILES_ACTIVE=prod
